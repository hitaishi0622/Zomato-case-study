# Copy to .env and fill in values. Never commit .env to version control.

# Required for LLM (Phase 3+) — Groq API key
GROQ_API_KEY=your-groq-api-key-here
# Or use a generic name:
# LLM_API_KEY=your-groq-api-key-here

# Optional overrides (defaults in config/settings.yaml)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
# DATA_CACHE_PATH=data/restaurants.parquet
# MAX_CANDIDATES_FOR_LLM=15
# MAX_RECOMMENDATIONS=5
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SEC=60
# BUDGET_TIERS_PATH=config/budget_tiers.yaml
