# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# IMPORTANT: Copy to .env and fill in values. NEVER commit .env to version control.
#
# For Streamlit Cloud deployment:
#   1. Do NOT upload .env to GitHub
#   2. Add secrets via Streamlit Cloud dashboard (Settings > Secrets)
#   3. Use the format below for secrets.toml
#
# For local development:
#   1. Create .env in project root with variables below
#   2. Prefix with export for bash: export GROQ_API_KEY="..."
#   3. Prefix with set for cmd: set GROQ_API_KEY=...
# ============================================================================

# ============================================================================
# REQUIRED: LLM API Keys
# ============================================================================
# Get your free Groq API key from: https://console.groq.com/keys
# The key gives you rate-limited free tier access to Groq's LLaMA 3.3 model
#
GROQ_API_KEY=your-groq-api-key-from-console.groq.com

# Alternative: Use generic LLM_API_KEY (if configured)
# LLM_API_KEY=your-groq-api-key-here

# ============================================================================
# OPTIONAL: LLM Configuration
# ============================================================================
# These override defaults in config/settings.yaml
# Uncomment to customize LLM behavior
#

# LLM provider (currently only 'groq' is supported)
# LLM_PROVIDER=groq

# Groq model name (available: llama-3.3-70b-versatile, mixtral-8x7b, etc.)
# See https://console.groq.com/docs/models for latest models
# LLM_MODEL=llama-3.3-70b-versatile

# Model creativity/randomness: 0.0 = deterministic, 1.0 = creative
# Default: 0.2 (very consistent recommendations)
# LLM_TEMPERATURE=0.2

# API request timeout in seconds (default: 60)
# LLM_TIMEOUT_SEC=60

# ============================================================================
# OPTIONAL: Filtering Configuration
# ============================================================================
# Recommendation engine tuning
#

# Max restaurants passed to LLM for ranking (default: 15)
# Increase for more candidates, decrease for speed
# MAX_CANDIDATES_FOR_LLM=15

# Max final recommendations returned (default: 5)
# MAX_RECOMMENDATIONS=5

# ============================================================================
# OPTIONAL: Dataset Configuration
# ============================================================================
# Override data sources and cache paths
#

# Hugging Face dataset ID (default: ManikaSaini/zomato-restaurant-recommendation)
# Change to use a different dataset
# HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# Cache file path (default: data/restaurants.parquet)
# Supports .parquet (fast) or .csv (fallback)
# DATA_CACHE_PATH=data/restaurants.parquet

# ============================================================================
# OPTIONAL: Budget Tiers Configuration
# ============================================================================
# Path to budget tier definitions (default: config/budget_tiers.yaml)
# BUDGET_TIERS_PATH=config/budget_tiers.yaml

# ============================================================================
# FOR STREAMLIT CLOUD DEPLOYMENT
# ============================================================================
# Add the following to your Streamlit Cloud secrets (Settings > Secrets):
#
# GROQ_API_KEY = "your-api-key-here"
# LLM_MODEL = "llama-3.3-70b-versatile"
# LLM_TEMPERATURE = "0.2"
# MAX_CANDIDATES_FOR_LLM = "15"
# MAX_RECOMMENDATIONS = "5"
#
# These will be auto-loaded as environment variables by Streamlit Cloud.
# ============================================================================
